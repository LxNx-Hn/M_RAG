# Optional runtime API keys.
# Keep empty unless an explicitly approved evaluation/service phase needs it.
OPENAI_API_KEY=

# Runtime generation model.
GENERATION_MODEL=K-intelligence/Midm-2.0-Base-Instruct

# Local smoke validation only. Do not use Mini outputs for thesis claims.
# GENERATION_MODEL=K-intelligence/Midm-2.0-Mini-Instruct

# Backend API settings.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set false for retrieval-only lightweight runtime mode.
LOAD_GPU_MODELS=true

# Runtime storage paths. Use mounted volumes in deployment.
MRAG_DATA_DIR=./data
MRAG_CHROMA_DIR=./chroma_db

# Local or Alice smoke default.
DATABASE_URL=sqlite+aiosqlite:///./mrag.db

# Production service example.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mrag
